rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function profileData(uid) {
      return get(/databases/$(database)/documents/user_profiles/$(uid)).data;
    }
    function isFriendOf(ownerUid) {
      return isSignedIn()
        && ownerUid != request.auth.uid
        && request.auth.uid in profileData(ownerUid).get('friendUids', []);
    }

    match /schedules/{docId} {
      allow read, write: if isSignedIn() && request.auth.uid == docId;
    }

    match /user_profiles/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid);
      allow delete: if isOwner(uid);
    }

    match /friend_requests/{requestId} {
      allow read: if isSignedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.fromUid == request.auth.uid;
      allow update: if isSignedIn()
        && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
      allow delete: if isSignedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /friendships/{friendshipId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberUids;
      allow create, update, delete: if isSignedIn()
        && request.auth.uid in request.resource.data.memberUids;
    }

    match /share_snapshots/{uid} {
      allow read: if isOwner(uid) || isFriendOf(uid);
      allow write: if isOwner(uid);
    }

    match /shared_tasks/{taskId} {
      allow read, update: if isSignedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.memberUids;
      allow delete: if isSignedIn() && request.auth.uid in resource.data.memberUids;
    }

    match /referrals/{referralId} {
      allow read: if isSignedIn()
        && (resource.data.referrerUid == request.auth.uid || resource.data.refereeUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.refereeUid == request.auth.uid;
      allow update: if isSignedIn()
        && (resource.data.referrerUid == request.auth.uid || resource.data.refereeUid == request.auth.uid);
    }

    match /referral_rewards/{rewardId} {
      allow read: if isSignedIn() && resource.data.referrerUid == request.auth.uid;
      allow create, update: if isSignedIn() && request.resource.data.referrerUid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
