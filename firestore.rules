rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function profileData(uid) {
      return get(/databases/$(database)/documents/user_profiles/$(uid)).data;
    }
    function isFriendOf(ownerUid) {
      return isSignedIn()
        && ownerUid != request.auth.uid
        && request.auth.uid in profileData(ownerUid).get('friendUids', []);
    }
    function notBlockedBy(uid) {
      return exists(/databases/$(database)/documents/user_profiles/$(uid))
        && !(request.auth.uid in profileData(uid).get('blockedUids', []));
    }
    function sortedFriendshipId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }
    function otherOf(members) {
      return members[0] == request.auth.uid ? members[1] : members[0];
    }
    function listAddedOnlySelf(before, after) {
      return after.hasAll(before)
        && after.size() == before.size() + 1
        && request.auth.uid in after
        && !(request.auth.uid in before);
    }
    function listRemovedOnlySelf(before, after) {
      return before.hasAll(after)
        && before.size() == after.size() + 1
        && request.auth.uid in before
        && !(request.auth.uid in after);
    }
    function friendshipExists(a, b) {
      return exists(/databases/$(database)/documents/friendships/$(sortedFriendshipId(a, b)));
    }
    function incomingFriendRequest(fromUid, toUid) {
      return get(/databases/$(database)/documents/friend_requests/$(fromUid + '_' + toUid)).data;
    }
    function hasIncomingAcceptableRequest(fromUid) {
      return exists(/databases/$(database)/documents/friend_requests/$(fromUid + '_' + request.auth.uid))
        && incomingFriendRequest(fromUid, request.auth.uid).fromUid == fromUid
        && incomingFriendRequest(fromUid, request.auth.uid).toUid == request.auth.uid
        && incomingFriendRequest(fromUid, request.auth.uid).status in ['pending', 'accepted'];
    }

    function canReadFriendRequest() {
      return isSignedIn()
        && (
          resource == null
          || resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid
        );
    }
    function canReadReferral() {
      return isSignedIn()
        && (
          resource == null
          || resource.data.referrerUid == request.auth.uid
          || resource.data.refereeUid == request.auth.uid
        );
    }
    function canReadReferralReward() {
      return isSignedIn()
        && (
          resource == null
          || resource.data.referrerUid == request.auth.uid
        );
    }

    function onlySelfAddedToFriends(profileUid) {
      return isSignedIn()
        && request.auth.uid != profileUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friendUids', 'updatedAt'])
        && listAddedOnlySelf(resource.data.get('friendUids', []), request.resource.data.get('friendUids', []))
        && friendshipExists(request.auth.uid, profileUid)
        && notBlockedBy(profileUid);
    }
    function onlySelfRemovedFromFriends(profileUid) {
      return isSignedIn()
        && request.auth.uid != profileUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friendUids', 'updatedAt'])
        && listRemovedOnlySelf(resource.data.get('friendUids', []), request.resource.data.get('friendUids', []));
    }
    function ownerDidNotForgePro(uid) {
      return request.resource.data.get('referralProUntilIso', '') == resource.data.get('referralProUntilIso', '');
    }

    match /schedules/{docId} {
      allow read, write: if isSignedIn() && request.auth.uid == docId;
    }

    match /user_profiles/{uid} {
      allow get: if isOwner(uid)
        || (resource != null && isSignedIn() && request.auth.uid in resource.data.get('friendUids', []));
      allow list: if false;
      allow create: if isOwner(uid);
      allow update: if (isOwner(uid) && ownerDidNotForgePro(uid))
        || onlySelfAddedToFriends(uid)
        || onlySelfRemovedFromFriends(uid);
      allow delete: if isOwner(uid);
    }

    match /invite_codes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'allowFriendRequests', 'updatedAt']);
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /friend_requests/{requestId} {
      allow read: if canReadFriendRequest();
      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isSignedIn()
        && resource.data.fromUid == request.resource.data.fromUid
        && resource.data.toUid == request.resource.data.toUid
        && (
          (resource.data.toUid == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status in ['accepted', 'declined'])
          || (resource.data.fromUid == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'cancelled')
        );
      allow delete: if isSignedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /friendships/{friendshipId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if isSignedIn()
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() == 2
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.memberUids[0] != request.resource.data.memberUids[1]
        && friendshipId == sortedFriendshipId(request.resource.data.memberUids[0], request.resource.data.memberUids[1])
        && notBlockedBy(otherOf(request.resource.data.memberUids))
        && (
          hasIncomingAcceptableRequest(otherOf(request.resource.data.memberUids))
          || (
            request.resource.data.keys().hasAny(['inviteCode'])
            && exists(/databases/$(database)/documents/invite_codes/$(request.resource.data.inviteCode))
            && get(/databases/$(database)/documents/invite_codes/$(request.resource.data.inviteCode)).data.uid
              == otherOf(request.resource.data.memberUids)
            && get(/databases/$(database)/documents/invite_codes/$(request.resource.data.inviteCode)).data.get('allowFriendRequests', true) == true
          )
        );
      allow update: if false;
      allow delete: if isSignedIn() && request.auth.uid in resource.data.memberUids;
    }

    match /share_snapshots/{uid} {
      allow read: if isOwner(uid) || isFriendOf(uid);
      allow write: if isOwner(uid);
    }

    match /shared_tasks/{taskId} {
      function canReadSharedTask() {
        return isSignedIn() && (
          request.auth.uid in resource.data.get('memberUids', [])
          || resource.data.get('inviteeUid', '') == request.auth.uid
        );
      }
      function membershipUnchanged() {
        return request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && resource.data.memberUids.hasAll(request.resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size();
      }
      function identityFieldsUnchanged() {
        return request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.get('inviteeUid', '') == resource.data.get('inviteeUid', '');
      }
      function inviteeResponding() {
        return resource.data.get('inviteeUid', '') == request.auth.uid
          && resource.data.get('status', '') == 'pending'
          && identityFieldsUnchanged()
          && (
            (request.resource.data.status == 'declined' && membershipUnchanged())
            || (request.resource.data.status == 'active'
              && listAddedOnlySelf(resource.data.get('memberUids', []), request.resource.data.get('memberUids', [])))
          );
      }
      function memberPatch() {
        return request.auth.uid in resource.data.get('memberUids', [])
          && identityFieldsUnchanged()
          && membershipUnchanged();
      }
      allow read: if canReadSharedTask();
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() == 1
        && request.auth.uid in request.resource.data.memberUids
        && (
          request.resource.data.get('inviteeUid', null) == null
          || (
            request.resource.data.inviteeUid is string
            && request.resource.data.inviteeUid != request.auth.uid
            && request.resource.data.inviteeUid in profileData(request.auth.uid).get('friendUids', [])
          )
        );
      allow update: if isSignedIn() && (inviteeResponding() || memberPatch());
      allow delete: if isSignedIn()
        && (request.auth.uid == resource.data.createdBy
          || request.auth.uid in resource.data.get('memberUids', []));
    }

    match /referrals/{referralId} {
      allow read: if canReadReferral();
      allow create: if isSignedIn()
        && request.resource.data.refereeUid == request.auth.uid
        && request.resource.data.referrerUid is string
        && request.resource.data.referrerUid != request.auth.uid
        && request.resource.data.referralCode is string
        && exists(/databases/$(database)/documents/invite_codes/$(request.resource.data.referralCode))
        && get(/databases/$(database)/documents/invite_codes/$(request.resource.data.referralCode)).data.uid
          == request.resource.data.referrerUid;
      allow update: if isSignedIn()
        && resource.data.referrerUid == request.auth.uid
        && request.resource.data.referrerUid == resource.data.referrerUid
        && request.resource.data.refereeUid == resource.data.refereeUid
        && request.resource.data.referralCode == resource.data.referralCode;
    }

    match /referral_rewards/{rewardId} {
      allow read: if canReadReferralReward();
      allow create: if isSignedIn()
        && request.resource.data.referrerUid == request.auth.uid
        && request.resource.data.refereeUid is string
        && request.resource.data.referrerUid != request.resource.data.refereeUid
        && request.resource.data.referralId is string
        && exists(/databases/$(database)/documents/referrals/$(request.resource.data.referralId))
        && get(/databases/$(database)/documents/referrals/$(request.resource.data.referralId)).data.referrerUid
          == request.auth.uid
        && get(/databases/$(database)/documents/referrals/$(request.resource.data.referralId)).data.refereeUid
          == request.resource.data.refereeUid
        && get(/databases/$(database)/documents/referrals/$(request.resource.data.referralId)).data.status in ['pending', 'qualified'];
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
