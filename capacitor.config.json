{
  "appId": "app.proyou.proyou",
  "appName": "PROYOU",
  "webDir": "dist",
  "packageClassList": [
    "SignInWithApple",
    "FirebaseAuthenticationPlugin",
    "FirebaseMessagingPlugin",
    "AppPlugin",
    "LocalNotificationsPlugin",
    "PurchasesPlugin",
    "ProyouApnsPlugin",
    "ProyouWidgetPlugin",
    "ProyouMusicPickerPlugin",
    "ProyouNutritionLabelPlugin",
    "ProyouAlarmSoundPlugin"
  ],
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#fff8f7"
  },
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "https://*.firebaseapp.com",
      "https://*.googleapis.com",
      "https://appleid.apple.com",
      "https://*.apple.com",
      "https://cute-schedule.vercel.app",
      "https://*.vercel.app"
    ]
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": false,
      "providers": [
        "apple.com"
      ],
      "authDomain": "cute-schedule.vercel.app"
    },
    "FirebaseMessaging": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
